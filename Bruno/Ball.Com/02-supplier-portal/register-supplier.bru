meta {
  name: Register Supplier (via portal)
  type: http
  seq: 1
}

post {
  url: {{supplierPortalUrl}}/api/supplier/register
  body: json
  auth: none
}

body:json {
  {
    "name": "ACME Supplies",
    "contactEmail": "sales@acme.com"
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.id) {
    bru.setVar("supplierId", data.id);
    bru.setEnvVar("supplierId", data.id);
  }
}
