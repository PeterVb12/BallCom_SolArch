meta {
  name: Pay Order (warehouse portal flow)
  type: http
  seq: 2
}

post {
  url: {{paymentUrl}}/api/payments
  body: json
  auth: none
}

body:json {
  {
    "orderId": {{orderId}},
    "paymentMethod": "ForwardPay"
  }
}

script:pre-request {
  await new Promise((resolve) => setTimeout(resolve, 2000));
}
