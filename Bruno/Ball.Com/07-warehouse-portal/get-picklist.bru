meta {
  name: Get PickList (warehouse portal flow)
  type: http
  seq: 3
}

get {
  url: {{warehousePortalUrl}}/api/warehouse/picklists
  body: none
  auth: none
}

script:pre-request {
  await new Promise((resolve) => setTimeout(resolve, 3000));
}

script:post-response {
  const orderId = Number(bru.getVar("orderId") || bru.getEnvVar("orderId"));
  const data = res.getBody();
  const pickList = Array.isArray(data)
    ? data.find((p) => p.orderId === orderId)
    : data;

  if (pickList && pickList.id) {
    bru.setVar("pickListId", pickList.id);
    bru.setEnvVar("pickListId", pickList.id);
  }
}

tests {
  test("picklist exists for order", function () {
    expect(res.getStatus()).to.equal(200);
    const orderId = Number(bru.getVar("orderId") || bru.getEnvVar("orderId"));
    const data = res.getBody();
    const pickList = Array.isArray(data) ? data.find((p) => p.orderId === orderId) : data;
    expect(pickList).to.be.an("object");
    expect(pickList.id).to.be.a("string");
  });
}
