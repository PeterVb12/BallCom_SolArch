meta {
  name: Wait For Logistics Shipment
  type: http
  seq: 9
}

get {
  url: {{logisticsUrl}}/api/shipments/order/{{servicePortalOrderId}}
  body: none
  auth: none
}

script:pre-request {
  await new Promise((resolve) => setTimeout(resolve, 5000));
}

tests {
  test("shipment exists after warehouse ready", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
