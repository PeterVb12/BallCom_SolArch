meta {
  name: Wait For Shipment (logistics async)
  type: http
  seq: 10
}

get {
  url: {{logisticsUrl}}/api/shipments/order/{{orderId}}
  body: none
  auth: none
}

script:pre-request {
  await new Promise((resolve) => setTimeout(resolve, 5000));
}

tests {
  test("shipment exists", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
