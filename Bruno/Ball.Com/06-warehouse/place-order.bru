meta {
  name: Place Order (warehouse flow)
  type: http
  seq: 1
}

post {
  url: {{orderingUrl}}/api/orders
  body: json
  auth: none
}

body:json {
  {
    "customer": {
      "email": "warehouse@example.com",
      "fullName": "Warehouse Direct",
      "street": "Logistieklaan 3",
      "city": "Breda",
      "postalCode": "4811AB",
      "country": "NL"
    },
    "items": [
      { "productId": "{{productId}}", "quantity": 1, "price": 0 }
    ]
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.id) {
    bru.setVar("orderId", data.id);
    bru.setEnvVar("orderId", data.id);
  }
}
